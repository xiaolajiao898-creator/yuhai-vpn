// 品牌标识：与 favicon 同一张 64×64 图，圆角 16，底 #bbef68，波浪 #14201c。
const mark = `<svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#bbef68"/><g fill="none" stroke="#14201c" stroke-width="4" stroke-linecap="round"><path d="M13 22q9-8 19 0t19 0M13 32q9-8 19 0t19 0M13 42q9-8 19 0t19 0"/></g></svg>`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/assets/site.css" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script src="/assets/site.js" defer></script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="brand" href="/" aria-label="宇海 首页"><Fragment set:html={mark} /><span class="brand-name">宇海</span><span class="brand-latin">YUHAI</span></a>
        <nav class="nav-links" aria-label="主导航">
          <a class="hide-sm" href="/#product">产品</a>
          <a class="hide-sm" href="/#support">支持范围</a>
          <a class="hide-sm" href="/#account">账户</a>
          <a class="hide-sm" href="/#faq">常见问题</a>
          <a class="btn btn-primary btn-sm" href="/download/">下载</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <a class="brand" href="/" aria-label="宇海 首页"><Fragment set:html={mark} /><span class="brand-name">宇海</span></a>
        <nav aria-label="页脚导航">
          <a href="/download/">下载与校验</a>
          <a href="/#support">支持范围</a>
          <a href="/#faq">常见问题</a>
        </nav>
        <span>© 2026 宇海 · 官方网站仅 yhvpn.io</span>
      </div>
    </footer>
  </body>
</html>
