---
const { title = '宇海 · 一键连接的加密网络', description = '宇海：打开就能连，选择新加坡、美国、日本等地区线路，连接状态清清楚楚。WireGuard 加密，USDT 地址注册与付款，官方签名安卓客户端。' } = Astro.props;
// 统一品牌标识：深海蓝底 + 两道潮线 + 一点亮蓝（与 App、后台同一符号）。
const mark = `<svg class="brand-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#143951"/><path d="M6 18.5c2.8 0 2.8-2.2 5.7-2.2s2.9 2.2 5.7 2.2 2.8-2.2 5.7-2.2c1.4 0 2.1.5 2.9 1.1" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><path d="M8.5 23c2.3 0 2.3-1.6 4.7-1.6s2.4 1.6 4.7 1.6 2.4-1.6 4.7-1.6" stroke="#fff" stroke-opacity=".55" stroke-width="1.8" stroke-linecap="round"/><circle cx="21.5" cy="10" r="2.4" fill="#79D0E3"/></svg>`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
