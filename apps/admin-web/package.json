{
  "name": "yuhai-admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen": "openapi-typescript ../../api/openapi/admin.yaml -o src/api/admin.d.ts",
    "test:api": "node --test test/*.test.mjs",
    "build:demo": "tsc -b && vite build --config vite.preview.config.ts",
    "preview:demo": "vite preview --config vite.preview.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@tanstack/react-query": "^5.59.0",
    "antd": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "openapi-typescript": "^7.4.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
